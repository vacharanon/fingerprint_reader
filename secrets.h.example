// ESP8266 only — SHA-1 fingerprint of the backend's SSL certificate.
// Obtain with: openssl s_client -connect your-host:443 | openssl x509 -fingerprint -noout
#define FINGERPRINT "AA BB CC DD EE FF 00 11 22 33 44 55 66 77 88 99 AA BB CC DD"

